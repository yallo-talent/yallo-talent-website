#!/usr/bin/env sh

# biome is scoped to the staged set, never the repository.
#
# `biome check --write .` formatted all 194 files on every commit. Anything it
# touched outside the staged set stayed in the working tree, so the other
# session picked it up and carried it into an unrelated commit — that is how
# this session's own file was reformatted inside three of session B's round 5
# commits. Two worktrees on one repository make that a routine collision.
#
# --staged restricts the pass to files already prepared for this commit. Biome
# writes to disk, so anything it rewrites has to be re-staged or the commit
# records the unformatted version; the re-add is scoped to the same list and
# never widens to `git add -A`.
STAGED=$(git diff --cached --name-only --diff-filter=ACMR)

if [ -n "$STAGED" ]; then
  pnpm biome check --write --staged --no-errors-on-unmatched || exit 1
  # Re-stage only what was already staged. Nothing outside the list can enter
  # the commit, and a file biome left alone is unaffected by the re-add.
  echo "$STAGED" | while IFS= read -r f; do
    [ -f "$f" ] && git add -- "$f"
  done
fi

node .claude/hooks/check-colours.js
# Round 18. The blurred-orb ban has been re-added three times in eight rounds —
# round 8 claimed a deletion that never happened, round 14 fixed the hero pair,
# round 18 found the band pair in the same file. It is a source-only check over 33
# stylesheets and costs milliseconds, so it runs at commit time rather than
# waiting for CI to find it after the fact.
node scripts/check-orbs.mjs
node scripts/check-type-scale.mjs
node scripts/check-taxonomy.mjs
# Round 16. Two tracked paths differing only by case are ONE file on macOS,
# which is how a client wordmark was silently overwritten by a platform icon.
# It costs milliseconds and it reads the index, not the directory.
node scripts/check-asset-case.mjs
