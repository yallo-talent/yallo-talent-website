{
  "name": "talent.yallo.co",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check:terms": "node scripts/check-terminology.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:type": "node scripts/check-type-scale.mjs --strict",
    "check:a11y": "node scripts/check-a11y.mjs",
    "check:motion": "node scripts/check-motion.mjs",
    "check:type-render": "node scripts/check-rendered-type.mjs",
    "check:interaction": "node scripts/check-interaction.mjs",
    "check:reflow": "node scripts/check-reflow.mjs",
    "check:visual": "node scripts/capture-home.mjs",
    "test": "playwright test",
    "prepare": "husky || true",
    "check:taxonomy": "node scripts/check-taxonomy.mjs",
    "check:yallo-case": "node scripts/check-yallo-case.mjs",
    "check:estate": "node scripts/check-estate-interaction.mjs",
    "check:marks": "node scripts/check-marks.mjs",
    "marks:measure": "node scripts/measure-marks.mjs",
    "logos": "node scripts/build-logos.mjs && node scripts/measure-marks.mjs"
  },
  "engines": {
    "node": "22.x",
    "pnpm": "10.x"
  },
  "pnpm": {
    "overrides": {
      "postcss@<8.5.18": "^8.5.23",
      "sharp@<0.35.0": "^0.35.3"
    }
  },
  "dependencies": {
    "framer-motion": "12",
    "gray-matter": "^4.0.3",
    "next": "16.2.12",
    "next-mdx-remote": "^6.0.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.18.0",
    "sharp": "^0.35.3",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@biomejs/biome": "^2.5.5",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/turndown": "^5.0.6",
    "cheerio": "^1.2.0",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "husky": "^9.1.7",
    "tailwindcss": "^4",
    "turndown": "^7.2.4",
    "typescript": "^5.9.3"
  }
}
