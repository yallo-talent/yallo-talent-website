# Public site origin used for canonical URLs, OG tags and the sitemap.
# Defaults to http://localhost:3000 for local dev. Set explicitly to the
# production domain in production only — any other value (or unset)
# causes the site to serve noindex/nofollow metadata and a Disallow: /
# robots rule, so preview, placeholder and local deployments are never
# indexed.
NEXT_PUBLIC_SITE_URL=https://yallo.co

# Site assistant launcher. ON by default per Sumeet's ruling R-A1
# (context-round16-scope.md §1) — the assistant ships on and stays on, so the
# committed default is the shipped default and there is one build shape. Only
# the exact string "false" disables it; unset, blank or misspelt lands on the
# default. Leave this key out of your .env.local unless you need the site
# WITHOUT the assistant.
NEXT_PUBLIC_ASSISTANT_ENABLED=

# Neon Postgres connection string. Required — api/brief and api/cv persist
# every validated submission here before attempting email delivery, and
# refuse to report success if this is unset or unreachable. Apply pending
# migrations with `DATABASE_URL=... pnpm db:migrate`.
#
# ONE database, per ruling R-A2. There is no separate local instance: a brief
# you submit on localhost lands in the same table as a real one. src/lib/env-
# warning.ts prints a startup banner saying so.
DATABASE_URL=

# Anthropic API key for the site assistant (src/lib/assistant/client.ts).
# Required — the assistant now ships on, so an unset key means every
# conversation returns the API's error path rather than an answer.
ANTHROPIC_API_KEY=

# Transactional mail (Resend). All three are optional: unset or blank falls
# back to the code defaults in src/lib/mail-config.ts. Blank is treated as
# unset deliberately — `??` alone would let an empty value override the
# default with an empty sender.
#
# RESEND_API_KEY unset means submissions are persisted but not delivered, and
# the route says so rather than reporting success.
RESEND_API_KEY=
# Sender. Defaults per route: brief@yallo.co for api/brief, bench@yallo.co for
# api/cv. Production needs SPF and DKIM aligned for whichever domain sends.
RESEND_FROM=
# Recipients, comma-separated. Defaults to brief@yallo.co,hello@yallo.co.
# Locally, point this at your own address so a test submission does not land
# in the business inbox.
RESEND_TO=

# ── The admin cockpit (/admin) ──────────────────────────────────────────────
# Server-only, every one of them. None carries a NEXT_PUBLIC_ prefix, so Next.js
# will not inline them into a client chunk — and scripts/check-admin-isolation.mjs
# greps the served bundle for each value rather than trusting that.
#
# Session encryption. Generate with: openssl rand -base64 32
AUTH_SECRET=
# The single admin identity. There is no sign-up and no second account.
ADMIN_EMAIL=
# A scrypt hash, never the password. Produce it with `pnpm admin:hash`, which
# reads the password with terminal echo off and prints only the hash.
ADMIN_PASSWORD_HASH=
# Fine-grained GitHub token, Contents: read and write, THIS REPOSITORY ONLY.
# Used by the case-study write pane to commit to content/. Absent is fine: the
# read panes work without it and the write pane reports that it is missing.
ADMIN_GITHUB_TOKEN=
