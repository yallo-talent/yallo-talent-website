# Public site origin used for canonical URLs, OG tags and the sitemap.
# Defaults to http://localhost:3000 for local dev. Set explicitly to the
# production domain in production only — any other value (or unset)
# causes the site to serve noindex/nofollow metadata and a Disallow: /
# robots rule, so preview, placeholder and local deployments are never
# indexed.
NEXT_PUBLIC_SITE_URL=https://yallo.co

# Site assistant launcher. Off until Sumeet has read the pilot conversations
# per context-round13-chatbot.md §6. Unset or any value other than "true"
# keeps the launcher out of the initial bundle and off every route.
NEXT_PUBLIC_ASSISTANT_ENABLED=false

# Neon Postgres connection string. Required — api/brief and api/cv persist
# every validated submission here before attempting email delivery, and
# refuse to report success if this is unset or unreachable. Apply pending
# migrations with `DATABASE_URL=... pnpm db:migrate`.
DATABASE_URL=
