# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results
/playwright-report

# check:phase8's raw --json output. CI writes it to the workspace root and
# uploads it as a build artefact; it never belongs in the repo.
/phase8-results.json

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Local-only: a 5.1GB WordPress export of the legacy site. Kept on disk for
# reference during the port-and-convert, never in git — it was committed by
# accident once and the pack went to 4.8GB, which failed the push outright.
old_wordpress/

# Audit scratch. Subagents write probe scripts and result dumps here; a
# git add -A swept six of them (including a 13,565-line results.json) into
# 72b1e4d. Working files, never artefacts.
.scratch-impeccable/

# Reference workbooks — kept on disk, never committed.
# One of these (the SAP L1/L2 sheet) carries plaintext credentials, and they are
# a 3-year-old reference rather than build input, so they have no business in the
# repo at all. See docs/status/SECURITY-prototype-workbooks.md.
prototype/L1, L2 Details/

# Parallel-session build dirs (see next.config.ts distDir)
/.next-*/

# Candidate personal data. Talent-pool exports, never build input and never
# committed (git log --all --diff-filter=A -- 'docs/lti-reports/*' is empty),
# but explicit rather than relying on it staying an accident nobody made. A
# careless git add -A is the one irreversible action this repo can still take.
docs/lti-reports/
